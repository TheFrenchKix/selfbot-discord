# Copier vers .env (jamais commité) et remplir. Régénérer tout secret déjà exposé.

# --- Instance unique (python main.py) ---
DISCORD_TOKEN=
EXCHANGERATE_API_KEY=
TATUM_API_KEY=
BLOCKCYPHER_TOKEN=

# --- Swap LTC <-> USDT Polygon (au moins un fournisseur pour exécuter; `swaprates` marche sans clé) ---
SWAPZONE_API_KEY=
FIXEDFLOAT_API_KEY=
FIXEDFLOAT_API_SECRET=
SWAP_PROVIDER=auto        # auto = meilleur devis | swapzone | fixedfloat
SWAP_MAX_FEE_PCT=3       # refuse un swap plus cher que X % sous le prix du marché

PROXY_URL=                # ex: http://user:pass@host:port/  (optionnel)
USER_AGENT=               # optionnel; par défaut celui de la lib Discord
COMMAND_PREFIX=.

LTC_ADDRESS=
USDT_ADDRESS=
MSG_CHANNEL_ID=
VOUCH_CHANNEL_ID=
TRANSACTION_CHANNEL_ID=
IGNORED_GUILD_IDS=        # ids séparés par des virgules (serveurs ignorés par le sniper)
MAX_PRICE=100
DEBUG=0

# --- Contrôleur multi-instance (python -m selfbot.controller) ---
CONTROLLER_TOKEN=         # token d'un BOT applicatif (pas un compte utilisateur)
OWNER_IDS=                # ids Discord des propriétaires, séparés par des virgules
INSTANCES_DIR=instances
LOG_WEBHOOK_URL=          # webhook Discord recevant les logs des instances (ou !setwebhook en DM)
WORKER_PYTHON=            # interpréteur des workers (discord.py-self), défaut: celui du contrôleur
# SELFBOT_MASTER_KEY=     # backend Fernet hors Windows: python -m selfbot.secrets genkey
